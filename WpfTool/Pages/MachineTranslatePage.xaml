<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WpfTool.Pages.MachineTranslatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="mc" Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Margin="28,24,28,32">
            <StackPanel Spacing="5">
                <TextBlock x:Name="DefaultTranslateHeader" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="设置默认翻译服务、语言和服务凭据" Opacity="0.68" />
            </StackPanel>
            <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="默认翻译" FontWeight="SemiBold" />
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="DefaultTranslateProvideComboBox" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="DefaultTranslateProvideComboBox_SelectionChanged" />
                            <ComboBox x:Name="AiProviderComboBox" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Stretch" SelectionChanged="AiProviderComboBox_SelectionChanged" />
                            <ComboBox x:Name="AiModelComboBox" Grid.Column="2" Visibility="Collapsed" HorizontalAlignment="Stretch" SelectionChanged="AiModelComboBox_SelectionChanged" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SourceLanguageComboBox" Grid.Column="0" HorizontalAlignment="Stretch" SelectionChanged="SourceLanguageComboBox_SelectionChanged" />
                            <ComboBox x:Name="TargetLanguageComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="TargetLanguageComboBox_SelectionChanged" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="翻译服务凭据" FontWeight="SemiBold" />
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="AppID" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBox Grid.Column="1" x:Name="BaiduAiAppIdInput" TextChanged="BaiduAiAppIdInput_TextChanged" />
                            <TextBlock Grid.Row="1" Text="SecretKey" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="BaiduAiSecretKeyInput" PasswordChanged="BaiduAiSecretKeyInput_PasswordChanged" />
                            <HyperlinkButton Grid.Row="2" Grid.Column="1" Content="百度翻译开放平台" NavigateUri="https://fanyi-api.baidu.com/product/113" HorizontalAlignment="Left" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.7" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Url" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBox Grid.Column="1" x:Name="DeeplxUrlInput" TextChanged="DeeplxUrlInput_TextChanged" />
                            <TextBlock Grid.Row="1" Text="Authorization" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="DeeplxAuthorizationInput" PasswordChanged="DeeplxAuthorizationInput_PasswordChanged" />
                            <HyperlinkButton Grid.Row="2" Grid.Column="1" Content="Deeplx 项目主页" NavigateUri="https://deeplx.owo.network/" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="AiProviderHeader" FontWeight="SemiBold" />
                    <TextBlock Text="一个服务商可配置多个模型，兼容 OpenAI 接口" Opacity="0.68" TextWrapping="Wrap" />
                    <Button x:Name="AddAiProviderButton" Content="添加服务商" Click="AddAiProviderButton_Click" HorizontalAlignment="Left" />
                    <StackPanel x:Name="AiProviderPanel" Spacing="8" />
                    <HyperlinkButton x:Name="AiProviderNote" Content="OpenAI" NavigateUri="https://github.com/for-the-zero/Free-LLM-Collection" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="GoogleCloudNote" TextWrapping="Wrap" Opacity="0.75" Margin="2,0,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
