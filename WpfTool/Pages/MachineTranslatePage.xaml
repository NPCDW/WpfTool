<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WpfTool.Pages.MachineTranslatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Margin="16">
            <TextBlock x:Name="DefaultTranslateHeader" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox x:Name="DefaultTranslateProvideComboBox" Width="200"
                          SelectionChanged="DefaultTranslateProvideComboBox_SelectionChanged" />
                <ComboBox x:Name="AiProviderComboBox" Width="150" Visibility="Collapsed"
                          SelectionChanged="AiProviderComboBox_SelectionChanged" />
                <ComboBox x:Name="AiModelComboBox" Width="150" Visibility="Collapsed"
                          SelectionChanged="AiModelComboBox_SelectionChanged" />
                <ComboBox x:Name="SourceLanguageComboBox" Width="150"
                          SelectionChanged="SourceLanguageComboBox_SelectionChanged" />
                <ComboBox x:Name="TargetLanguageComboBox" Width="150"
                          SelectionChanged="TargetLanguageComboBox_SelectionChanged" />
            </StackPanel>

            <!-- 百度翻译开放平台 -->
            <Grid ColumnSpacing="12" RowSpacing="8" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="AppID" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBox Grid.Column="1" x:Name="BaiduAiAppIdInput" TextChanged="BaiduAiAppIdInput_TextChanged" />
                <TextBlock Grid.Row="1" Text="SecretKey" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="BaiduAiSecretKeyInput"
                             PasswordChanged="BaiduAiSecretKeyInput_PasswordChanged" />
                <HyperlinkButton Grid.Row="2" Grid.Column="1" Content="百度翻译开放平台"
                                 NavigateUri="https://fanyi-api.baidu.com/product/113" />
            </Grid>

            <!-- Deeplx -->
            <Grid ColumnSpacing="12" RowSpacing="8" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Url" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBox Grid.Column="1" x:Name="DeeplxUrlInput" TextChanged="DeeplxUrlInput_TextChanged" />
                <TextBlock Grid.Row="1" Text="Authorization" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="DeeplxAuthorizationInput"
                             PasswordChanged="DeeplxAuthorizationInput_PasswordChanged" />
                <HyperlinkButton Grid.Row="2" Grid.Column="1" Content="Deeplx"
                                 NavigateUri="https://deeplx.owo.network/" />
            </Grid>

            <!-- AI 翻译：多服务商、多模型 -->
            <StackPanel Spacing="8" Margin="0,8,0,0">
                <TextBlock x:Name="AiProviderHeader" FontWeight="SemiBold" />
                <Button x:Name="AddAiProviderButton" Content="添加" Click="AddAiProviderButton_Click" />
                <StackPanel x:Name="AiProviderPanel" Spacing="8" />
                <HyperlinkButton x:Name="AiProviderNote" Content="OpenAI"
                                 NavigateUri="https://github.com/for-the-zero/Free-LLM-Collection" />
            </StackPanel>

            <TextBlock x:Name="GoogleCloudNote" TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.75" />
        </StackPanel>
    </ScrollViewer>
</Page>
