<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WpfTool.Pages.OcrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="mc" Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Margin="28,24,28,32">
            <StackPanel Spacing="5">
                <TextBlock x:Name="DefaultOcrHeader" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="选择默认识别服务、识别方式和语言" Opacity="0.68" />
            </StackPanel>
            <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="默认识别" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="DefaultOcrProvideComboBox" Grid.Column="0" HorizontalAlignment="Stretch"
                                  SelectionChanged="DefaultOcrProvideComboBox_SelectionChanged" />
                        <ComboBox x:Name="DefaultOcrTypeComboBox" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="DefaultOcrTypeComboBox_SelectionChanged" />
                        <ComboBox x:Name="DefaultOcrLanguageComboBox" Grid.Column="2" HorizontalAlignment="Stretch"
                                  SelectionChanged="DefaultOcrLanguageComboBox_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="服务凭据" FontWeight="SemiBold" />
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="SecretID" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBox Grid.Column="1" x:Name="TencentCloudOcrSecretIdInput" TextChanged="TencentCloudOcrSecretIdInput_TextChanged" />
                            <TextBlock Grid.Row="1" Text="SecretKey" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="TencentCloudOcrSecretKeyInput" PasswordChanged="TencentCloudOcrSecretKeyInput_PasswordChanged" />
                            <HyperlinkButton Grid.Row="2" Grid.Column="1" Content="腾讯云 OCR 文档" NavigateUri="https://cloud.tencent.com/document/product/866/35945" HorizontalAlignment="Left" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.7" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="AppKey" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBox Grid.Column="1" x:Name="BaiduCloudAppKeyInput" TextChanged="BaiduCloudAppKeyInput_TextChanged" />
                            <TextBlock Grid.Row="1" Text="SecretKey" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="BaiduCloudSecretKeyInput" PasswordChanged="BaiduCloudSecretKeyInput_PasswordChanged" />
                            <HyperlinkButton Grid.Row="2" Grid.Column="1" Content="百度云 OCR 文档" NavigateUri="https://cloud.baidu.com/doc/OCR/s/fk3h7xu7h" HorizontalAlignment="Left" />
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.7" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="SecretKey" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <PasswordBox Grid.Column="1" x:Name="SpaceOcrApiKeyInput" PasswordChanged="SpaceOcrApiKeyInput_PasswordChanged" />
                            <HyperlinkButton Grid.Row="1" Grid.Column="1" Content="SpaceOCR API 文档" NavigateUri="https://ocr.space/OCRAPI" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
