<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WpfTool.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="VersionHeader" VerticalAlignment="Center" Width="160" />
                <HyperlinkButton Content="2.0.0.0"
                                 NavigateUri="https://github.com/NPCDW/WpfTool/releases" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="LicenseHeader" VerticalAlignment="Center" Width="160" />
                <HyperlinkButton Content="MIT License" NavigateUri="https://en.wikipedia.org/wiki/MIT_License" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="CopyrightHeader" VerticalAlignment="Center" Width="160" />
                <HyperlinkButton Content="© NPCDW 2023" NavigateUri="https://github.com/NPCDW" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="SourceCodeHeader" VerticalAlignment="Center" Width="160" />
                <HyperlinkButton Content="https://github.com/NPCDW/WpfTool"
                                 NavigateUri="https://github.com/NPCDW/WpfTool" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="FeedbackHeader" VerticalAlignment="Center" Width="160" />
                <Button x:Name="EmailButton" Content="chenyongli0520@gmail.com" Click="EmailButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="LinksHeader" VerticalAlignment="Center" Width="160" />
                <HyperlinkButton Content="https://www.0520.site" NavigateUri="https://www.0520.site" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
