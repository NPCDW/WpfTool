<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WpfTool.Pages.GlobalHotkeyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="8" Margin="16">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="OcrHeader" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <TextBox Grid.Column="1" x:Name="OcrHotKeyTextBox" IsReadOnly="True"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />
                <TextBlock Grid.Column="2" x:Name="OcrHotKeyConflictLabel" VerticalAlignment="Center"
                           Foreground="Red" Visibility="Collapsed" />

                <TextBlock Grid.Row="1" x:Name="WordTranslationHeader" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="GetWordsTranslateHotKeyTextBox" IsReadOnly="True"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="GetWordsTranslateHotKeyConflictLabel"
                           VerticalAlignment="Center" Foreground="Red" Visibility="Collapsed" />

                <TextBlock Grid.Row="2" x:Name="ScreenshotTranslationHeader" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ScreenshotTranslateHotKeyTextBox" IsReadOnly="True"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />
                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="ScreenshotTranslateHotKeyConflictLabel"
                           VerticalAlignment="Center" Foreground="Red" Visibility="Collapsed" />

                <TextBlock Grid.Row="3" x:Name="TopMostHeader" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TopMostHotKeyTextBox" IsReadOnly="True"
                         PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />
                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="TopMostHotKeyConflictLabel"
                           VerticalAlignment="Center" Foreground="Red" Visibility="Collapsed" />

                <Button Grid.Row="4" Grid.Column="1" x:Name="ResetButton" Click="ResetButton_Click"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
