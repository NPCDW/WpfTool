<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="WpfTool.Pages.GlobalHotkeyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Loaded="Page_Loaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="32,28">
            <StackPanel Spacing="6">
                <TextBlock x:Name="PageTitle" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="PageDescription" Opacity="0.68" />
            </StackPanel>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="OcrHeader" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="OcrHotKeyTextBox" IsReadOnly="True" PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />
                        <TextBlock Grid.Column="2" x:Name="OcrHotKeyConflictLabel" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="WordTranslationHeader" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" x:Name="GetWordsTranslateHotKeyTextBox" IsReadOnly="True" PreviewKeyDown="HotKeyTextBox_PreviewKeyDown" />
                        <TextBlock Grid.Column="2" x:Name="GetWordsTranslateHotKeyConflictLabel" VerticalAlignment="Center" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    </Grid>
                    <Button x:Name="ResetButton" Click="ResetButton_Click" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
