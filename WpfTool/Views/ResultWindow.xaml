<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WpfTool.Views.ResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="mc"
    Title="文字识别/机器翻译">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
            <TextBlock x:Name="TitleTextBlock" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="13" FontWeight="SemiBold" Opacity="0.9" />
        </Grid>

        <Grid Grid.Row="1" Margin="16,4,16,16" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="12,10" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="DefaultOcrProvideComboBox" Grid.Column="0" HorizontalAlignment="Stretch"
                                      SelectionChanged="DefaultOcrProvideComboBox_SelectionChanged" />
                            <ComboBox x:Name="DefaultOcrTypeComboBox" Grid.Column="1" HorizontalAlignment="Stretch"
                                      SelectionChanged="OcrTypeComboBox_SelectionChanged" />
                            <ComboBox x:Name="DefaultOcrLanguageComboBox" Grid.Column="2" HorizontalAlignment="Stretch"
                                      SelectionChanged="OcrTypeComboBox_SelectionChanged" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <CheckBox x:Name="DefaultOcrSettingCheck" Content="设为默认"
                                      Checked="DefaultOcrSettingCheck_Checked" VerticalAlignment="Center" />
                            <Button x:Name="OcrButton" Content="重新识别" Click="OcrButton_Click"
                                    HorizontalAlignment="Right" MinWidth="104" />
                        </Grid>
                    </Grid>
                </Border>
                <TextBox Grid.Row="1" x:Name="OcrTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Padding="14" CornerRadius="10" />
            </Grid>

            <Grid Grid.Row="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Padding="12,10" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="DefaultTranslateProvideComboBox" Grid.Column="0" HorizontalAlignment="Stretch"
                                      SelectionChanged="DefaultTranslateProvideComboBox_SelectionChanged" />
                            <ComboBox x:Name="AiProviderComboBox" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Stretch" />
                            <ComboBox x:Name="AiModelComboBox" Grid.Column="2" Visibility="Collapsed" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="SourceLanguageComboBox" Grid.Column="0" HorizontalAlignment="Stretch"
                                      SelectionChanged="TranslateLanguageComboBox_SelectionChanged" />
                            <ComboBox x:Name="TargetLanguageComboBox" Grid.Column="1" HorizontalAlignment="Stretch"
                                      SelectionChanged="TranslateLanguageComboBox_SelectionChanged" />
                        </Grid>
                        <Grid Grid.Row="2">
                            <CheckBox x:Name="DefaultTranslateSettingCheck" Content="设为默认"
                                      Checked="DefaultTranslateSettingCheck_Checked" VerticalAlignment="Center" />
                            <Button x:Name="TranslateButton" Content="翻译" Click="TranslateButton_Click"
                                    HorizontalAlignment="Right" MinWidth="104" />
                        </Grid>
                    </Grid>
                </Border>
                <TextBox Grid.Row="1" x:Name="TranslateTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Padding="14" CornerRadius="10" />
            </Grid>
        </Grid>
    </Grid>
</Window>
